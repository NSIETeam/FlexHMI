          "y": 404,
          "w": 560,
          "h": 260,
          "tagId": "transfer_flow",
          "color": "#343c43"
        },
        {
          "id": "balance_chart",
          "kind": "chart",
          "label": "总水量 · 保持不变",
          "x": 660,
          "y": 404,
          "w": 560,
          "h": 260,
          "tagId": "total_volume",
          "color": "#343c43"
        }
      ],
      "connections": []
    }
  ],
  "control": {
    "rules": [
      {
        "id": "water_level_control",
        "name": "高位水箱自动补水",
        "enabled": true,
        "inputTag": "destination_level",
        "outputTag": "pump_command",
        "direction": "low",
        "onThreshold": 35,
        "offThreshold": 40,
        "onValue": 1,
        "offValue": 0,
        "outputMin": 0,
        "outputMax": 1,
        "holdMs": 1000,
        "minIntervalMs": 2000,
        "maxAgeMs": 3500,
        "guards": [
          {
            "tagId": "source_level",
            "op": "gt",
            "value": 5
          }
        ]
      }
    ]
  }
}