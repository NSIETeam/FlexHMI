          "id": "supply_in",
          "from": "tank_1",
          "to": "pump_1",
          "tagId": "pump_running"
        },
        {
          "id": "supply_out",
          "from": "pump_1",
          "to": "tank_2",
          "tagId": "pump_running"
        }
      ]
    },
    {
      "id": "trends",
      "name": "液位与输送趋势",
      "width": 1280,
      "height": 720,
      "background": "#ffffff",
      "components": [
        {
          "id": "source_chart",
          "kind": "chart",
          "label": "原水箱液位 · 输送时下降",
          "x": 48,
          "y": 64,
          "w": 560,
          "h": 300,
          "tagId": "source_level",
          "color": "#343c43"
        },
        {
          "id": "destination_chart",
          "kind": "chart",
          "label": "高位水箱液位 · 输送时上升",
          "x": 660,
          "y": 64,
          "w": 560,
          "h": 300,
          "tagId": "destination_level",
          "color": "#343c43"
        },
        {
          "id": "flow_chart",
          "kind": "chart",
          "label": "输送流量 · 停泵为零",
