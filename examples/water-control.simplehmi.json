{
  "schemaVersion": 1,
  "id": "water_control_demo",
  "name": "双水箱供水 · 守恒模拟",
  "simulation": "water-transfer",
  "system": {
    "mode": "intelligent-control"
  },
  "devices": [
    {
      "id": "supply",
      "name": "双水箱过程模拟",
      "protocol": "sim",
      "host": "127.0.0.1",
      "port": 502,
      "unitId": 1,
      "polling": 1000,
      "timeout": 2000,
      "tags": [
        {
          "id": "source_level",
          "name": "原水箱液位",
          "address": 1,
          "initial": 65,
          "unit": "%",
          "type": "Float32",
          "memory": "400000",
          "divisor": 1,
          "sim": "manual",
          "writable": false
        },
        {
          "id": "destination_level",
          "name": "高位水箱液位",
          "address": 3,
          "initial": 30,
          "unit": "%",
          "type": "Float32",
          "memory": "400000",
          "divisor": 1,
          "sim": "manual",
          "writable": false
        },
        {
          "id": "pump_command",
          "name": "供水泵启停命令",
          "address": 5,
          "initial": 0,
          "unit": "",
          "type": "Bool",
          "memory": "0",
          "divisor": 1,
          "sim": "manual",
          "writable": true
        },
        {
          "id": "pump_running",
          "name": "供水泵实际运行",
          "address": 6,
          "initial": 1,
          "unit": "",
          "type": "Bool",
          "memory": "0",
          "divisor": 1,
          "sim": "manual",
          "writable": false
        },
        {
          "id": "transfer_flow",
          "name": "输送流量",
          "address": 7,
          "initial": 36,
          "unit": "m³/h",
          "type": "Float32",
          "memory": "400000",
          "divisor": 1,
          "sim": "manual",
          "writable": false
        },
        {
          "id": "source_volume",
          "name": "原水箱水量",
          "address": 9,
          "initial": 3.25,
          "unit": "m³",
          "type": "Float32",
          "memory": "400000",
          "divisor": 1,
          "sim": "manual",
          "writable": false
        },
        {
          "id": "destination_volume",
          "name": "高位水箱水量",
          "address": 11,
          "initial": 0.9,
          "unit": "m³",
          "type": "Float32",
          "memory": "400000",
          "divisor": 1,
          "sim": "manual",
          "writable": false
