        {
          "id": "source_low",
          "name": "原水箱低水位停泵",
          "address": 15,
          "initial": 0,
          "unit": "",
          "type": "Bool",
          "memory": "0",
          "divisor": 1,
          "sim": "manual",
          "writable": false
        },
        {
          "id": "destination_high",
          "name": "高位水箱高水位停泵",
          "address": 16,
          "initial": 0,
          "unit": "",
          "type": "Bool",
          "memory": "0",
          "divisor": 1,
          "sim": "manual",
          "writable": false
        }
      ]
    }
